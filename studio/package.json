{
  "name": "@firefly-weave/studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --configuration production",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.contracts.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "icons": "node scripts/build-icons.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*config.ts\""
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@foblex/2d": "1.2.2",
    "@foblex/flow": "19.3.0",
    "@foblex/mediator": "1.1.3",
    "@foblex/platform": "1.0.4",
    "@foblex/utils": "1.1.1",
    "rxjs": "7.8.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "lucide-static": "1.52.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
