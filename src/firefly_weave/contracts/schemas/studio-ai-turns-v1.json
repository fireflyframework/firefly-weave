{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firefly-weave:schema:studio-ai-turns:v1",
  "title": "Recorded AI turns",
  "description": "One aiTurns entry of Studio test data: the model turns an AI task or AI agent replays when it is simulated.",
  "type": "object",
  "required": ["turns"],
  "additionalProperties": false,
  "properties": {
    "turns": {"type": "array", "maxItems": 33, "items": {"oneOf": [
      {"type": "object", "required": ["toolCalls"], "additionalProperties": false,
       "properties": {"text": {"type": "string"},
                      "toolCalls": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
                        "type": "object", "required": ["name", "arguments"], "additionalProperties": false,
                        "properties": {"name": {"type": "string"}, "arguments": {"type": "object"}}}}}},
      {"type": "object", "required": ["final"], "additionalProperties": false,
       "properties": {"final": true, "text": {"type": "string"}}}]}},
    "memory": {"type": "array", "maxItems": 200, "items": {
      "type": "object", "required": ["role", "content"], "additionalProperties": false,
      "properties": {"role": {"enum": ["user", "assistant"]}, "content": true}}},
    "autoApprove": {"type": "boolean", "default": false},
    "source": {"enum": ["manual", "simulated", "test-call", "run"]},
    "runId": {"type": "string", "format": "uuid"},
    "runEnvironmentId": {"type": "string", "format": "uuid"},
    "configHash": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"},
    "upstreamHash": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"}
  },
  "if": {"required": ["source"], "properties": {"source": {"enum": ["run", "test-call"]}}},
  "then": {"required": ["runId", "runEnvironmentId"]},
  "dependentRequired": {"runId": ["source", "runEnvironmentId"]}
}
