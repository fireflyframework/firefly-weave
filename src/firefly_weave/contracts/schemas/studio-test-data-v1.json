{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firefly-weave:schema:studio-test-data:v1",
  "title": "Studio test data",
  "type": "object",
  "required": ["schemaVersion", "kind", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "weave.studio/testData"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "input": {"$ref": "#/$defs/entry"},
    "pins": {"type": "object", "maxProperties": 1000, "propertyNames": {"$ref": "#/$defs/key"},
             "additionalProperties": {"$ref": "#/$defs/pin"}},
    "signals": {"type": "object", "maxProperties": 1000, "propertyNames": {"$ref": "#/$defs/key"},
      "additionalProperties": {"oneOf": [
        {"type": "object", "required": ["payload"], "additionalProperties": false,
         "properties": {"payload": true, "afterSeconds": {"type": "integer", "minimum": 0},
                        "frame": {"$ref": "#/$defs/frame"}, "source": {"$ref": "#/$defs/source"},
                        "runId": {"$ref": "#/$defs/uuid"}, "runEnvironmentId": {"$ref": "#/$defs/uuid"}},
         "allOf": [{"$ref": "#/$defs/provenance"}]},
        {"type": "object", "required": ["outcome"], "additionalProperties": false,
         "properties": {"outcome": {"const": "timeout"}, "frame": {"$ref": "#/$defs/frame"}}}]}},
    "humans": {"type": "object", "maxProperties": 1000, "propertyNames": {"$ref": "#/$defs/key"},
      "additionalProperties": {"oneOf": [
        {"type": "object", "required": ["decision", "data"], "additionalProperties": false,
         "properties": {"decision": {"type": "string"}, "data": true,
                        "frame": {"$ref": "#/$defs/frame"}, "source": {"$ref": "#/$defs/source"},
                        "runId": {"$ref": "#/$defs/uuid"}, "runEnvironmentId": {"$ref": "#/$defs/uuid"}},
         "allOf": [{"$ref": "#/$defs/provenance"}]},
        {"type": "object", "required": ["outcome"], "additionalProperties": false,
         "properties": {"outcome": {"const": "expire"}, "frame": {"$ref": "#/$defs/frame"}}}]}},
    "aiTurns": {"type": "object", "maxProperties": 1000, "propertyNames": {"$ref": "#/$defs/key"},
                "additionalProperties": {"$ref": "#/$defs/aiTurns"},
                "description": "Items of turns follow urn:firefly-weave:schema:studio-ai-turns:v1"},
    "workflows": {"type": "object", "maxProperties": 50, "propertyNames": {"$ref": "#/$defs/reference"},
      "additionalProperties": {"type": "object", "required": ["mocks"], "additionalProperties": false,
        "properties": {"mocks": {"type": "object", "maxProperties": 1000, "propertyNames": {"$ref": "#/$defs/key"},
                                 "additionalProperties": {"$ref": "#/$defs/mock"}}}}},
    "waits": {"type": "object", "additionalProperties": false,
              "properties": {"autoAdvance": {"type": "boolean", "default": true}}}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "hash": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"},
    "key": {"$comment": "InstanceKeyText of firefly_weave.contracts.instance_keys; JSON Schema cannot import it, so a contract test keeps this copy equal",
            "type": "string", "maxLength": 512,
            "pattern": "^(?:@?[A-Za-z0-9][A-Za-z0-9_.:@-]*(?:\\[(?:0|[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)\\])*(?:#[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*)?(?:~(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991))?)$"},
    "frame": {"type": "string", "maxLength": 1024,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(\\[(0|[1-9][0-9]*)\\])*(/[A-Za-z0-9][A-Za-z0-9_.-]*(\\[(0|[1-9][0-9]*)\\])*)*$"},
    "reference": {"type": "string", "maxLength": 300,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
    "source": {"enum": ["manual", "schema", "simulated", "test-call", "run"]},
    "provenance": {
      "if": {"required": ["source"], "properties": {"source": {"enum": ["run", "test-call"]}}},
      "then": {"required": ["runId", "runEnvironmentId"]},
      "dependentRequired": {"runId": ["source", "runEnvironmentId"]}},
    "entry": {"type": "object", "required": ["value", "source"], "additionalProperties": false,
      "properties": {"value": true, "source": {"$ref": "#/$defs/source"},
                     "runId": {"$ref": "#/$defs/uuid"}, "runEnvironmentId": {"$ref": "#/$defs/uuid"}},
      "allOf": [{"$ref": "#/$defs/provenance"}]},
    "pin": {"type": "object",
      "required": ["output", "source", "pinnedAt", "configHash", "contractHash", "upstreamHash"],
      "additionalProperties": false,
      "properties": {"output": true,
                     "source": {"$ref": "#/$defs/source"},
                     "pinnedAt": {"type": "string", "format": "date-time"},
                     "configHash": {"$ref": "#/$defs/hash"},
                     "contractHash": {"$ref": "#/$defs/hash"},
                     "upstreamHash": {"$ref": "#/$defs/hash"},
                     "runId": {"$ref": "#/$defs/uuid"}, "runEnvironmentId": {"$ref": "#/$defs/uuid"}},
      "allOf": [{"$ref": "#/$defs/provenance"}]},
    "mock": {"type": "object", "required": ["output", "source"], "additionalProperties": false,
      "properties": {"output": true, "source": {"$ref": "#/$defs/source"},
                     "runId": {"$ref": "#/$defs/uuid"}, "runEnvironmentId": {"$ref": "#/$defs/uuid"}},
      "allOf": [{"$ref": "#/$defs/provenance"}]},
    "aiTurns": {"type": "object", "required": ["turns"], "additionalProperties": false,
      "properties": {"turns": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
                     "memory": {"type": "array", "maxItems": 200, "items": {
                       "type": "object", "required": ["role", "content"], "additionalProperties": false,
                       "properties": {"role": {"enum": ["user", "assistant"]}, "content": true}}},
                     "autoApprove": {"type": "boolean"},
                     "source": {"enum": ["manual", "simulated", "test-call", "run"]},
                     "runId": {"$ref": "#/$defs/uuid"}, "runEnvironmentId": {"$ref": "#/$defs/uuid"},
                     "configHash": {"$ref": "#/$defs/hash"}, "upstreamHash": {"$ref": "#/$defs/hash"}},
      "allOf": [{"$ref": "#/$defs/provenance"}]}
  }
}
