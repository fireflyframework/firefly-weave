# Same pinned base as the server image, so prepare pulls it once.
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
WORKDIR /opt/acme
COPY --chmod=0644 server.py data.json /opt/acme/
USER 65532:65532
EXPOSE 8080 8081
CMD ["python", "-I", "/opt/acme/server.py"]
